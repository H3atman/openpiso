; OpenPiso Admin Windows Firewall rules for :3210 (ADR-0090).
;
; These hooks run inside the NSIS installer generated by Tauri v2. They allow
; inbound TCP 3210 (the Client/device API) and UDP 3210 (Server Discovery),
; scoped to the local subnet with no profile restriction: shop LANs are often
; left on the Public profile, so `remoteip=localsubnet` is the limit instead.
; TCP 8080 (Web Admin) is deliberately not opened; see docs/installation.md.
;
; The Admin installs per user (installMode currentUser), so the installer runs
; unelevated and the in-app updater re-runs it in passive mode. Rules are
; checked unelevated first, and only missing ones are changed through ONE
; elevated cmd (a single UAC prompt). An update over an install that already
; has both rules never prompts. A declined prompt or a netsh failure is only
; logged: the install or uninstall continues and the manual netsh commands in
; docs/installation.md remain the fallback.

!ifndef FW_TCP_RULE
  !define FW_TCP_RULE "OpenPiso device API"
  !define FW_UDP_RULE "OpenPiso discovery"
!endif

; Sets $R1 to the " & "-joined netsh commands still needed: with ADD=1, adds
; for missing rules; with ADD=0, deletes for present rules. Empty when none.
; `netsh advfirewall firewall show rule` exits non-zero when no rule matches.
!macro OPENPISO_FW_PENDING ADD
  StrCpy $R2 ""
  StrCpy $R3 ""
  nsExec::Exec 'netsh advfirewall firewall show rule name="${FW_TCP_RULE}"'
  Pop $R0
  !if ${ADD} == 1
    ${If} $R0 != 0
      StrCpy $R2 'netsh advfirewall firewall add rule name="${FW_TCP_RULE}" dir=in action=allow protocol=TCP localport=3210 remoteip=localsubnet'
    ${EndIf}
  !else
    ${If} $R0 == 0
      StrCpy $R2 'netsh advfirewall firewall delete rule name="${FW_TCP_RULE}"'
    ${EndIf}
  !endif
  nsExec::Exec 'netsh advfirewall firewall show rule name="${FW_UDP_RULE}"'
  Pop $R0
  !if ${ADD} == 1
    ${If} $R0 != 0
      StrCpy $R3 'netsh advfirewall firewall add rule name="${FW_UDP_RULE}" dir=in action=allow protocol=UDP localport=3210 remoteip=localsubnet'
    ${EndIf}
  !else
    ${If} $R0 == 0
      StrCpy $R3 'netsh advfirewall firewall delete rule name="${FW_UDP_RULE}"'
    ${EndIf}
  !endif
  ${If} $R2 != ""
  ${AndIf} $R3 != ""
    StrCpy $R1 "$R2 & $R3"
  ${Else}
    StrCpy $R1 "$R2$R3"
  ${EndIf}
!macroend

; Runs $R1 in one elevated cmd, then re-checks so the log reflects the result.
; cmd /C strips the outer quotes and keeps the quoted rule names intact.
!macro OPENPISO_FW_APPLY ADD
  !insertmacro OPENPISO_FW_PENDING ${ADD}
  ${If} $R1 == ""
    DetailPrint "Windows Firewall rules for :3210 need no change"
  ${Else}
    DetailPrint "Updating Windows Firewall rules for :3210 (administrator approval)..."
    ExecShellWait "runas" "$SYSDIR\cmd.exe" '/C "$R1"' SW_HIDE
    !insertmacro OPENPISO_FW_PENDING ${ADD}
    ${If} $R1 == ""
      DetailPrint "Windows Firewall rules for :3210 updated"
    ${Else}
      DetailPrint "WARNING: Windows Firewall rules for :3210 not updated (approval declined or netsh failed); see docs/installation.md"
    ${EndIf}
  ${EndIf}
!macroend

!macro NSIS_HOOK_POSTINSTALL
  !insertmacro OPENPISO_FW_APPLY 1
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  ; Tauri's template sets $UpdateMode from /UPDATE when an update runs this
  ; uninstaller; the reinstall keeps the rules, so leave them in place.
  ${If} $UpdateMode <> 1
    !insertmacro OPENPISO_FW_APPLY 0
  ${EndIf}
!macroend
