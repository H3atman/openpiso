; OpenPiso Client Guard service registration (ADR-0048).
;
; These hooks run inside the NSIS installer generated by Tauri v2.
; They register, start, stop, and unregister the OpenPisoClientGuard
; Windows service so a standard user cannot kill the Client.
;
; The install location of the Guard binary is NOT a guess. `bundle.resources`
; in tauri.conf.json maps the built binary to the target path
; `resources/client-guard.exe`, and Tauri's NSIS template installs
; resource targets relative to $INSTDIR — so the binary lands exactly at
; GUARD_EXE below. Change one and you must change the other; a mismatch is
; invisible at install time except through the exit-code checks in this file.
;
; A plain resource *array* entry would not work here: Tauri rewrites each `..`
; component of a relative resource path into a literal `_up_` directory, so
; "../../../target/release/client-guard.exe" installs to
; $INSTDIR\_up_\_up_\_up_\target\release\ and every `sc start` fails with
; "the system cannot find the file specified".

!ifndef GUARD_SERVICE
  !define GUARD_SERVICE "OpenPisoClientGuard"
  !define GUARD_EXE "$INSTDIR\resources\client-guard.exe"
  !define OLD_GUARD_EXE "$INSTDIR\resources\openpiso-client-guard.exe"
!endif

!macro NSIS_HOOK_POSTINSTALL
  ; Validate the replacement before stopping a working Guard. An incomplete
  ; bundle must not turn an existing protected installation into an unguarded
  ; one.
  IfFileExists "${GUARD_EXE}" guard_exe_found 0
    DetailPrint "ERROR: Guard binary missing at ${GUARD_EXE}"
    MessageBox MB_ICONSTOP|MB_OK \
      "Client Guard was not included in this installer.$\r$\n$\r$\n\
      Expected: ${GUARD_EXE}$\r$\n$\r$\n\
      Rebuild the installer with 'bun run build:installers' and reinstall." \
      /SD IDOK
    Abort
  guard_exe_found:

  ; Stop the existing stable service before changing its executable path.
  ; This is required on upgrades: sc start returns 1056 for an already-running
  ; service and would otherwise leave the old binary active indefinitely.
  DetailPrint "Stopping ${GUARD_SERVICE} service before upgrade..."
  nsExec::ExecToLog 'sc stop "${GUARD_SERVICE}"'
  Pop $R7
  ; 0 = stop requested, 1060 = a fresh install with no service yet,
  ; 1062 = the existing service was already stopped.
  ${If} $R7 == 0
    StrCpy $R8 0
    guard_wait_stopped:
      nsExec::ExecToLog 'cmd /C "sc query ${GUARD_SERVICE} | find /I "STOPPED""'
      Pop $R9
      ${If} $R9 == 0
        Goto guard_stopped
      ${EndIf}
      IntOp $R8 $R8 + 1
      ${If} $R8 >= 20
        DetailPrint "ERROR: ${GUARD_SERVICE} did not stop before upgrade"
        MessageBox MB_ICONSTOP|MB_OK \
          "Could not stop the existing Client Guard service. Close the Client \
          and retry the upgrade as Administrator." /SD IDOK
        Abort
      ${EndIf}
      Sleep 500
      Goto guard_wait_stopped
    guard_stopped:
  ${ElseIf} $R7 != 1060
  ${AndIf} $R7 != 1062
    DetailPrint "ERROR: sc stop failed with code $R7"
    MessageBox MB_ICONSTOP|MB_OK \
      "Could not stop the existing Client Guard service (sc stop returned $R7). \
      Retry the upgrade as Administrator." /SD IDOK
    Abort
  ${EndIf}

  ; Register and start the Guard service.
  ; sc.exe is present on every supported Windows version.
  DetailPrint "Registering ${GUARD_SERVICE} service..."

  ; Create the service: auto-start, runs as SYSTEM (default), depends on
  ; nothing, and uses the guard binary at the install location.
  nsExec::ExecToLog 'sc create "${GUARD_SERVICE}" binPath= "${GUARD_EXE}" start= auto DisplayName= "Client Guard"'
  Pop $R7
  ; 0 = created, 1073 = already exists (upgrade over an existing install).
  ${If} $R7 != 0
  ${AndIf} $R7 != 1073
    DetailPrint "ERROR: sc create failed with code $R7"
    MessageBox MB_ICONSTOP|MB_OK \
      "Could not register the Client Guard service (sc create returned $R7).$\r$\n$\r$\n\
      Tamper protection will NOT work. Re-run this installer as Administrator." \
      /SD IDOK
    nsExec::ExecToLog 'sc start "${GUARD_SERVICE}"'
    Pop $R8
    Abort
  ${EndIf}

  ; An upgrade may have left the old binary path registered; point the existing
  ; service at this install's binary before starting it.
  nsExec::ExecToLog 'sc config "${GUARD_SERVICE}" binPath= "${GUARD_EXE}" start= auto DisplayName= "Client Guard"'
  Pop $R7
  ${If} $R7 != 0
    DetailPrint "ERROR: sc config failed with code $R7"
    MessageBox MB_ICONSTOP|MB_OK \
      "Could not point the Client Guard service at the new binary (sc config \
      returned $R7). Retry the upgrade as Administrator." /SD IDOK
    ; The old binPath is still registered; restore protection before aborting.
    nsExec::ExecToLog 'sc start "${GUARD_SERVICE}"'
    Pop $R8
    Abort
  ${EndIf}

  ; Mark the service as not interacting with the desktop (explicit, though
  ; this is the default for services started after Windows Vista).
  nsExec::ExecToLog 'sc description "${GUARD_SERVICE}" "Prevents tampering with the OpenPiso Client by relaunching it on termination (ADR-0048)."'
  Pop $R7

  ; Start the service so it protects the Client immediately after install.
  nsExec::ExecToLog 'sc start "${GUARD_SERVICE}"'
  Pop $R7
  ; The service was verified stopped above, so only 0 is success here.
  ${If} $R7 != 0
    DetailPrint "ERROR: sc start failed with code $R7"
    MessageBox MB_ICONEXCLAMATION|MB_OK \
      "The Client Guard service was registered but would not start \
      (sc start returned $R7).$\r$\n$\r$\n\
      Tamper protection will NOT work until this is resolved. Check Event Viewer \
      > Windows Logs > System, source 'Service Control Manager'." \
      /SD IDOK
    ; Restore the previous package path before aborting the upgrade.
    nsExec::ExecToLog 'sc config "${GUARD_SERVICE}" binPath= "$INSTDIR\resources\openpiso-client-guard.exe" start= auto'
    Pop $R8
    nsExec::ExecToLog 'sc start "${GUARD_SERVICE}"'
    Pop $R8
    Abort
  ${EndIf}

  ; Remove the previous resource after the service has stopped using it.
  ; Keeping it would leave a stale executable in upgraded installations.
  Delete "${OLD_GUARD_EXE}"
  IfFileExists "${OLD_GUARD_EXE}" guard_old_resource_not_removed guard_old_resource_removed
  guard_old_resource_not_removed:
    DetailPrint "ERROR: previous Client Guard resource could not be removed"
    MessageBox MB_ICONSTOP|MB_OK \
      "The previous Client Guard binary is still in the install directory. \
      Retry the upgrade as Administrator." /SD IDOK
    Abort
  guard_old_resource_removed:

  DetailPrint "${GUARD_SERVICE} service registered and started"
  guard_done:
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  ; Stop the service before removing files so the Guard binary is not in use.
  DetailPrint "Stopping ${GUARD_SERVICE} service..."
  nsExec::ExecToLog 'sc stop "${GUARD_SERVICE}"'
  Pop $R7
  Sleep 2000  ; Give it a moment to stop gracefully
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  ; Remove the service after files are deleted.
  DetailPrint "Removing ${GUARD_SERVICE} service..."
  nsExec::ExecToLog 'sc delete "${GUARD_SERVICE}"'
  Pop $R7
  DetailPrint "${GUARD_SERVICE} service removed"
!macroend
