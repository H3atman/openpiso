{
  "name": "@openpiso/client",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "version": "0.12.3",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "tauri build",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "build:guard": "bun run scripts/build-guard.ts",
    "check:overlay": "bun run scripts/check-widget-overlay.ts",
    "check": "bun run check:overlay && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.tsc.json",
    "test:fullscreen-lock": "bun run scripts/fullscreen-lock-browser.ts",
    "test:change-password-dialog": "bun run scripts/change-password-dialog-browser.ts",
    "test:widget-claim": "bun run scripts/widget-claim-browser.ts",
    "test:widget-tier-menu": "bun run scripts/widget-tier-menu-browser.ts",
    "test:widget-tabs": "bun run scripts/widget-tabs-browser.ts",
    "test:attendance": "bun run scripts/attendance-browser.ts",
    "test:widget-parity": "bun run test:widget-tabs && bun run test:widget-claim && bun run test:widget-tier-menu && bun run test:wheel && bun run test:change-password-dialog && bun run test:fullscreen-lock && bun run test:attendance",
    "test:wheel": "bun run scripts/wheel-browser.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@openpiso/ui": "workspace:*",
    "@tauri-apps/api": "^2.8.0",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "svelte": "^5.39.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.4",
    "shadcn-svelte": "^1.3.0",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
